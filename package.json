{
  "name": "tournaments-app",
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first comparison-decision tool for running tournaments across any content type.",
  "license": "MIT",
  "author": "Christian Katzmann",
  "homepage": "https://github.com/Christian-Katzmann/Tournaments#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Christian-Katzmann/Tournaments.git"
  },
  "bugs": {
    "url": "https://github.com/Christian-Katzmann/Tournaments/issues"
  },
  "keywords": [
    "tournaments",
    "comparison",
    "elo",
    "ranking",
    "local-first",
    "ai-coding"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 5274",
    "build": "tsc -b && vite build",
    "start": "node server.mjs",
    "start:sample": "node server.mjs --sample",
    "test": "vitest run",
    "check": "npx tsc -b && vitest run",
    "desktop:icons": "APP_NAME='Tournaments' APP_SLUG='tournaments' ./scripts/desktop-icons.sh",
    "desktop:build": "./scripts/desktop-build.sh",
    "desktop:install": "./scripts/desktop-install.sh",
    "desktop:quit": "./scripts/desktop-quit.sh"
  },
  "dependencies": {
    "dompurify": "^3.4.5",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.0"
  }
}
